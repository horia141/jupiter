{
  "include": [
    "env.d.ts",
    "from-electron.d.ts",
    "from-capacitor.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "vite.config.mts",
    "react-router.config.ts",
    "../core/editorjs.d.ts",
    "../core/luxon.d.ts"
  ],
  "compilerOptions": {
    "types": ["@react-router/node", "vite/client", "google.maps"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "resolveJsonModule": true,
    "target": "ES2020",
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./app/*"],
      "#/core/*": ["../core/jupiter/core/*"],
      "@jupiter/core/*": ["../core/jupiter/core/*"]
    },
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
